{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pedi para meu marido",
  "version": "1.1.7",
  "identifier": "com.pediparameumarido.central",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "💕 Pedi para meu marido",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Crosshair Overlay",
        "url": "/#/overlay",
        "width": 500,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "startmenu",
        "title": "Menu Iniciar Híbrido",
        "url": "/#/startmenu",
        "width": 660,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],

    "resources": [
      "../bots/**/*",
      "../integrations/robloxbot/*.py",
      "../integrations/robloxbot/vendor/bots/**/*",
      "../integrations/yolov5_mm2/vendor/*.py",
      "../integrations/yolov5_mm2/vendor/models/**/*",
      "../integrations/yolov5_mm2/vendor/utils/**/*",
      "../integrations/yolov5_mm2/vendor/data/**/*",
      "../integrations/yolov5_mm2/vendor/weights/**/*",
      "../sdk/**/*",
      "../schemas/**/*",
      "../weights/**/*",
      "../scripts/setup_bot_runtime.ps1",
      "../runtime/python/requirements.txt"
    ],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
