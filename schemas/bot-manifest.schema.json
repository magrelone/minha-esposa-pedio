{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BotManifest",
  "description": "Schema canônico para validação de manifestos bot.json na plataforma de Bots",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "game",
    "provider",
    "runtime",
    "capabilities",
    "entrypoint"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "game": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "description": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": ["python", "native", "node"]
    },
    "entrypoint": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "screen_capture",
          "object_detection",
          "keyboard",
          "mouse",
          "movement",
          "gpu",
          "models",
          "audio"
        ]
      },
      "uniqueItems": true
    },
    "vision": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["legacy-yolov5", "onnx", "future-yolo", "custom"]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultConfidence": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.99
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        },
        "gpuRecommended": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
